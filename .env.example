# Tokenopolis configuration. Copy to .env and fill in what you need; every value has a default.
# Never commit .env: it holds your Datadog credentials and the panel password.

# ───────── appearance ─────────
# Name shown in titles, headers, the share card and the password prompt.
APP_NAME=Tokenopolis
# Default language for first-time visitors: en or pt-BR (each visitor can switch in the panel).
LOCALE=en
# IANA time zone for days, weeks and months (default: the host's zone), e.g. America/Sao_Paulo, Europe/Lisbon.
TIMEZONE=UTC

# ───────── data source ─────────
# datadog | mock | demo | file | path to a module exporting createSource(config).
# Unset: datadog when the Datadog credentials below exist, otherwise mock (generated data).
DATA_SOURCE=
# For DATA_SOURCE=file: a JSON of daily records (format in docs/contract.md).
DATA_FILE=data.json

# Datadog: a Personal/Service Access Token (ddpat_... / ddsat_...) that can run metric queries...
DD_ACCESS_TOKEN=
# ...or the classic pair: API key + Application key (unused when a token is set).
DD_API_KEY=
DD_APP_KEY=
# Datadog site: datadoghq.com (US1), datadoghq.eu, us3.datadoghq.com, us5.datadoghq.com, ap1.datadoghq.com...
DD_SITE=datadoghq.com
# Tag scope of the queries ("*" = everything), e.g. team:platform or service:claude-code.
DD_FILTER=*
# Tags of the Claude Code OpenTelemetry metrics.
DD_USER_TAG=user.email
DD_TYPE_TAG=type
DD_ORG_TAG=organization.id
DD_MODEL_TAG=model
METRIC_TOKENS=claude_code.token.usage
METRIC_SESSIONS=claude_code.session.count

# ───────── scoring ─────────
# Token types that count towards altitude and floors ("all" = every type). Cache reads are left
# out by default: they are most of the volume and measure context re-reading, not new work.
SCORE_TYPES=input,output,cachecreation
# Minimum scoring tokens to take part in the season, scaled by how far the season has run.
MIN_TOKENS=0
# People in the overall ranking.
TOP_N=25
# Season length: week (Monday to Sunday) or month.
SEASON_LENGTH=week
# Fixed summit in tokens; empty = the previous champion's total (or a projection).
SUMMIT_TOKENS=
# Past seasons shown in the hall of fame.
HALL_OF_FAME_SIZE=3
# Daily stage mark: fixed value, or empty = median of the last STAGE_MARK_DAYS workday winners.
STAGE_MARK_TOKENS=
STAGE_MARK_DAYS=10

# ───────── the city ─────────
# Buildings accumulate floors since this local date (YYYY-MM-DD). Default: 90 days ago.
CITIES_START=
# Tokens per floor.
CITY_FLOOR_TOKENS=1000000
# Teams with fewer people than this are not cities (personal accounts).
CITY_MIN_PEOPLE=5
# Abandoned buildings: on fire after more than IDLE_FIRE_DAYS calendar days without Claude, rubble after
# more than IDLE_RUBBLE_DAYS (0 turns each one off). Using Claude again puts the building back up.
IDLE_FIRE_DAYS=15
IDLE_RUBBLE_DAYS=30
# Display names per organization id (whole id or its first characters), comma separated.
# Example: CITY_NAMES=a1b2c3d4=Platform,e5f6a7b8=Data
CITY_NAMES=

# ───────── people ─────────
# Optional allow-list of e-mails (JSON array), see team.example.json.
TEAM_FILE=team.json
# Optional display names, avatars and photos per e-mail, see nicknames.example.json.
NICKNAMES_FILE=nicknames.json
# Optional belt program, see belts.example.json.
BELTS_FILE=belts.json
# Show people as "Swift Llama" instead of their names.
ANONYMIZE=false
# Optional salt mixed into person ids. Set it once before going live: changing it changes every id.
ID_SALT=

# ───────── server ─────────
PORT=3000
# Seconds between refreshes (min 15 with Datadog, 5 with generated data; default 60 / 15).
REFRESH_SECONDS=
# Set a password to protect the panel (basic auth; the user name is ignored). Empty = open.
PANEL_PASSWORD=
